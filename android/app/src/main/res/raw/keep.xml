<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's release-build resource shrinker only "sees" resources reached
  via a direct R.drawable.foo-style reference in compiled code. Both of the
  entries below are instead looked up dynamically, by string name, at
  runtime:

  - The audio_service plugin's own play/pause/stop/skip action icons
    (its Java resolves them via Resources.getIdentifier(name, "drawable",
    package), from the `androidIcon` string on each MediaControl - see
    AudioService.java's getResourceId()). Without this, they get stripped
    from release builds, and the missing icon throws
    "IllegalArgumentException: You must specify an icon resource id" deep
    in the platform media code every time the playback notification tries
    to update - which silently keeps the whole notification from ever
    showing, not just breaking one icon.

  - ic_stat_notification, this app's own small (status bar) notification
    icon, referenced the same dynamic way via
    AudioServiceConfig.androidNotificationIcon (see main.dart) - stripped
    for the identical reason, which alone is *also* enough to make the
    notification invalid and never post.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_stat_notification" />
